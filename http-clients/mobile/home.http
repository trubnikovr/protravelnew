### Mobile home collections
GET {{baseUrl}}/home
Accept: application/json

> {%
  client.test("Home collections are available", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.data.recommended.length > 0, "Recommended tours are empty");
    client.assert(response.body.data.popularDestinations.length > 0, "Popular destinations are empty");
    client.assert(response.body.data.hotTours.length > 0, "Hot tours are empty");
  });
%}
