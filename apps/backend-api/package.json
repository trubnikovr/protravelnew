{
  "name": "@protravel/backend-api",
  "version": "0.1.0",
  "private": true,
  "description": "ProTravel REST API",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"{src,scripts}/**/*.ts\" \"test/**/*.json\"",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "seed:admin": "ts-node --transpile-only scripts/seed-super-admin.ts",
    "seed:demo": "ts-node --transpile-only scripts/seed-demo-data.ts",
    "seed:reference": "ts-node --transpile-only scripts/seed-reference-data.ts",
    "probe:flight-airports": "ts-node --transpile-only scripts/probe-ttbooking-airports.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "test": "jest --runInBand --watchman=false",
    "test:watch": "jest --watch --watchman=false",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand --watchman=false",
    "test:cov": "jest --coverage --runInBand --watchman=false",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.2",
    "@types/supertest": "^7.2.1",
    "csv-parse": "^7.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "globals": "^13.24.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.13",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@app/(.*)$": "<rootDir>/$1",
      "^@core/(.*)$": "<rootDir>/core/$1",
      "^@entrypoints/(.*)$": "<rootDir>/entrypoints/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@sentry/nestjs": "^11.4.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "joi": "^17.13.4",
    "nestjs-pino": "^4.6.1",
    "p-limit": "^3.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3"
  }
}
