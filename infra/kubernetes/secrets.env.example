# Copy to secrets.env (ignored by Git), replace every value and never commit it.
DATABASE_PASSWORD=replace-me
REDIS_PASSWORD=replace-me
CUSTOMER_JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
CUSTOMER_JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
ADMIN_JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
DOCUMENT_ENCRYPTION_KEY=replace-with-64-hex-characters
NOTIFICATION_ENCRYPTION_KEY=replace-with-another-64-hex-characters
TTBOOKING_AGENCY_ID=replace-me
TTBOOKING_USER_ID=replace-me
TTBOOKING_PASSWORD=replace-me
TTBOOKING_SECRET_KEY=replace-me
RAIFFEISEN_PUBLIC_ID=
RAIFFEISEN_SECRET_KEY=
REDIS_USERNAME=default
SENTRY_DSN=
