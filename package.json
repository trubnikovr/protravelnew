{
  "name": "protravel-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "apps/backend-api",
    "apps/frontend-dashboard"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dashboard:build": "npm run build --workspace @protravel/frontend-dashboard",
    "dashboard:api:generate": "npm run api:generate --workspace @protravel/frontend-dashboard",
    "dashboard:dev": "npm run dev --workspace @protravel/frontend-dashboard",
    "d:d": "npm run dev --workspace @protravel/frontend-dashboard",
    "b:d": "npm run start:dev --workspace @protravel/backend-api",
    "m:s": "npm run start --workspace @protravel/mobile --",
    "dashboard:lint": "npm run lint --workspace @protravel/frontend-dashboard",
    "dashboard:test": "npm run test --workspace @protravel/frontend-dashboard",
    "dashboard:typecheck": "npm run typecheck --workspace @protravel/frontend-dashboard",
    "backend:build": "npm run build --workspace @protravel/backend-api",
    "backend:db:check": "drizzle-kit check --config apps/backend-api/drizzle.config.ts",
    "backend:db:generate": "drizzle-kit generate --config apps/backend-api/drizzle.config.ts",
    "backend:db:migrate": "drizzle-kit migrate --config apps/backend-api/drizzle.config.ts",
    "backend:db:studio": "drizzle-kit studio --config apps/backend-api/drizzle.config.ts",
    "backend:dev": "npm run start:dev --workspace @protravel/backend-api",
    "backend:lint": "npm run lint --workspace @protravel/backend-api",
    "backend:seed:admin": "npm run seed:admin --workspace @protravel/backend-api",
    "backend:seed:demo": "npm run seed:demo --workspace @protravel/backend-api",
    "backend:seed:reference": "npm run seed:reference --workspace @protravel/backend-api",
    "backend:customer:delete-travelers": "npm run customer:delete-travelers --workspace @protravel/backend-api --",
    "backend:start": "npm run start --workspace @protravel/backend-api",
    "backend:test": "npm run test --workspace @protravel/backend-api",
    "backend:typecheck": "npm run typecheck --workspace @protravel/backend-api",
    "infra:local:down": "docker compose -p backend-api -f infra/local/compose.yaml down",
    "infra:local:logs": "docker compose -p backend-api -f infra/local/compose.yaml logs -f",
    "infra:local:ps": "docker compose -p backend-api -f infra/local/compose.yaml ps",
    "infra:local:up": "docker compose -p backend-api -f infra/local/compose.yaml up -d",
    "mobile:android": "npm run android --workspace @protravel/mobile --",
    "mobile:api:generate": "npm run api:generate --workspace @protravel/mobile",
    "mobile:ios": "npm run ios --workspace @protravel/mobile --",
    "mobile:lint": "npm run lint --workspace @protravel/mobile",
    "mobile:start": "npm run start --workspace @protravel/mobile --",

    "mobile:test": "npm run test --workspace @protravel/mobile -- --runInBand --watchman=false",
    "mobile:typecheck": "npm run typecheck --workspace @protravel/mobile",
    "lint": "npm run backend:lint && npm run mobile:lint && npm run dashboard:lint",
    "test": "npm run backend:test && npm run mobile:test && npm run dashboard:test",
    "typecheck": "npm run backend:typecheck && npm run mobile:typecheck && npm run dashboard:typecheck"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >=25.0.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2"
  }
}
